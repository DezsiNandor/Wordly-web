rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Alapértelmezett zéró-bizalom elzárás (Default Deny)
    // Semmilyen ismeretlen útvonal vagy gyűjtemény nem érhető el kívülről
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Felhasználói szigorúan izolált tárterület (Strict Multi-Tenancy Isolation)
    // Csak és kizárólag a bejelentkezett felhasználó férhet hozzá a saját uid-jához tartozó adatokhoz!
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Szólisták algyűjteménye: users/{userId}/wordLists/{listId}
      match /wordLists/{listId} {
        // Olvasás és törlés: csak a saját fiók tulajdonosának
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        // Létrehozás és módosítás: autentikáció + séma validáció
        allow create, update: if request.auth != null 
          && request.auth.uid == userId
          // Lista nevének validálása (1 és 120 karakter közötti szöveg)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          // Szavak tömbjének validálása (maximum 5000 szó listánként védelemképp)
          && request.resource.data.words is list
          && request.resource.data.words.size() <= 5000;
      }
    }
  }
}
